<Activity x:Class="Main"
          xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Sequence DisplayName="Main">
    <Switch x:TypeArguments="x:String" Expression="[status]" DisplayName="Route status">
      <Switch.Cases>
        <x:String x:Key="OK">ok</x:String>
        <Sequence x:Key="ERR" DisplayName="Error branch">
          <LogMessage Level="Error" Message="[status]" />
        </Sequence>
      </Switch.Cases>
      <Switch.Default>
        <LogMessage Level="Warn" Message="[status]" />
      </Switch.Default>
    </Switch>
  </Sequence>
</Activity>
